# Copiar a deploy/.env en el servidor y completar. Este .env NO se sube al repo.

# --- Base de datos ---
DB_NAME=chispas
DB_USERNAME=chispas
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- JWT --- (base64 de 32 bytes: openssl rand -base64 32)
JWT_SECRET=

# --- Mail (Gmail con contraseña de aplicación) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Red del proxy del servidor (docker network ls) ---
IES63_NETWORK=deploy2025test_ies63_network

# --- Opcionales ---
# version de las imagenes (por defecto latest)
#BACK_TAG=
#FRONT_TAG=
# false para no cargar los datos iniciales la primera vez
#DATOS_INICIALES=false
